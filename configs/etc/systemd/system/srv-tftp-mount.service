[Unit]
Description=Bind mount for TFTP
Wants=network.target
After=network.target local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'mkdir -p /mnt/_OUTPUT/tmp/deploy/images && mount --bind /mnt/_OUTPUT/tmp/deploy/images /srv/tftp'
ExecStop=/bin/umount /srv/tftp || true
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

